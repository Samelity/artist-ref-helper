# 复制为同目录的 .env 后填写；.env 不要提交，也不要打进镜像
# 保存为 UTF-8（不带 BOM），值末尾不要混入空格

# ===== 数据库（必填）=====
# 首次启动时 PostgreSQL 会用这些值初始化；之后修改这里的值不会改变已有库
# 密码只使用字母、数字、下划线：Python 侧把密码直接拼进连接串，
# 出现 @ : / % # 或空格会导致连接失败
DB_NAME=artist_ref
DB_USER=artist
DB_PASSWORD=CHANGE_ME

# ===== pgAdmin 登录（必填，仅部署机本机访问 127.0.0.1:5050）=====
# 只在 pgadmin-data 卷为空时生效，之后修改需在 pgAdmin 页面里改
PGADMIN_EMAIL=CHANGE_ME@example.com
PGADMIN_PASSWORD=CHANGE_ME

# ===== 网络搜图（可选）=====
PIXABAY_API_KEY=
PEXELS_API_KEY=
BAIDU_APPID=
BAIDU_APPKEY=
